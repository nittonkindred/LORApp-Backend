generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Card {
  id                 String            @id @default(uuid())
  cardCode           String            @unique
  name               String
  description        String?
  levelUpDescription String?
  flavorText         String?
  cost               Int
  attack             Int?
  health             Int?
  collectible        Boolean           @default(true)
  isToken            Boolean           @default(false)
  artistName         String?
  expansionId        String
  cardType           CardType
  rarity             Rarity
  format             Format
  spellSpeed         SpellSpeed?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  fullImageUrl       String?
  gameImageUrl       String?
  expansion          Expansion         @relation(fields: [expansionId], references: [id])
  sourceAssociations CardAssociation[] @relation("SourceCard")
  targetAssociations CardAssociation[] @relation("TargetCard")
  keywords           CardKeyword[]
  regions            CardRegion[]
  subtypes           CardSubtype[]
}

model Expansion {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  icon      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cards     Card[]
}

model Region {
  id        String       @id @default(uuid())
  code      String       @unique
  name      String
  icon      String?
  color     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  cards     CardRegion[]
}

model Keyword {
  id          String        @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  code        String        @unique
  cards       CardKeyword[]
}

model Subtype {
  id        String        @id @default(uuid())
  name      String        @unique
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  cards     CardSubtype[]
}

model CardKeyword {
  cardId    String
  keywordId String
  card      Card    @relation(fields: [cardId], references: [id], onDelete: Cascade)
  keyword   Keyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@id([cardId, keywordId])
  @@index([keywordId])
}

model CardSubtype {
  cardId    String
  subtypeId String
  card      Card    @relation(fields: [cardId], references: [id], onDelete: Cascade)
  subtype   Subtype @relation(fields: [subtypeId], references: [id], onDelete: Cascade)

  @@id([cardId, subtypeId])
  @@index([subtypeId])
}

model CardRegion {
  cardId   String
  regionId String
  card     Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  region   Region @relation(fields: [regionId], references: [id], onDelete: Cascade)

  @@id([cardId, regionId])
  @@index([regionId])
}

model CardAssociation {
  sourceCardId String
  targetCardId String
  sourceCard   Card   @relation("SourceCard", fields: [sourceCardId], references: [id], onDelete: Cascade)
  targetCard   Card   @relation("TargetCard", fields: [targetCardId], references: [id], onDelete: Cascade)

  @@id([sourceCardId, targetCardId])
  @@index([targetCardId])
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum CardType {
  CHAMPION
  UNIT
  SPELL
  LANDMARK
  EQUIPMENT
  ABILITY
  TRAP
}

enum Rarity {
  COMMON
  RARE
  EPIC
  CHAMPION
  NONE
}

enum Format {
  STANDARD
  ETERNAL
}

enum SpellSpeed {
  BURST
  FAST
  SLOW
  FOCUS
}
